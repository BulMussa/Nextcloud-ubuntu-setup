# Copy to .env and fill in. 01-setup.sh creates .env for you with random passwords.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
# Space-separated hostnames / IPs you will open Nextcloud with
TRUSTED_DOMAINS="localhost 192.168.1.50 myserver"
# Storage limit per user, e.g. "200 GB", "1 TB" or "none" (applied by 01-setup.sh)
USER_QUOTA="200 GB"
